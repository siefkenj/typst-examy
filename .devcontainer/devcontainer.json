{
  "name": "typst-examy",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "myriad-dreamin.tinymist",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  },
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Docs dev server (npm run dev)"
    }
  },
  "postCreateCommand": "typst --version && npm ci"
}
